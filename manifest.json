{
  "manifest_version": 3,
  "name": "Google-Only Keyboard Input",
  "version": "1.0",
  "description": "Blocks keyboard input on all sites except Google services.",
    "icons": {
    "128": "icon.png"
  },
    "permissions": [],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}